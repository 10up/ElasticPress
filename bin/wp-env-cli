#!/usr/bin/env node

const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawn } = require('child_process');
const { loadConfig } = require('@wordpress/env/lib/config');

/**
 * Return the host user as `uid:gid`, matching how wp-env execs into containers.
 *
 * Windows reports -1 for both, so fall back to 1000 like wp-env does.
 *
 * @return {string} The host user in `uid:gid` format.
 */
function getHostUser() {
	const { uid, gid } = os.userInfo();

	return `${uid === -1 ? 1000 : uid}:${gid === -1 ? 1000 : gid}`;
}

function spawnCommandDirectly({ container, command, dockerComposeConfigPath }) {
	const composeCommand = [
		'-f',
		dockerComposeConfigPath,
		'exec -T',
		// Without this, commands run as root and any file they create is owned by
		// root on the host, which makes `wp-env destroy` fail with EACCES.
		'--user',
		getHostUser(),
		container,
		...command.split(' '), // The command will fail if passed as a complete string.
	];

	return new Promise((resolve, reject) => {
		let output = '';
		const childProc = spawn(`docker compose ${composeCommand.join(' ')}`, {
			stdio: 'pipe',
			shell: true,
			encoding: 'utf-8',
		});
		childProc.stdout.on('data', (data) => {
			output += data;
		});
		childProc.stderr.on('data', (data) => {
			output += data;
		});
		childProc.on('error', reject);
		childProc.on('exit', (code) => {
			// Code 130 is set if the user tries to exit with ctrl-c before using
			// ctrl-d (so it is not an error which should fail the script.)
			if (code === 0 || code === 130) {
				resolve(output);
			} else {
				const error = new Error(`Command failed with code ${code}`);
				error.output = output;
				error.code = code;
				reject(error);
			}
		});
	});
}

/**
 * Path of the environment's docker-compose.yml.
 *
 * Loading the wp-env config asks api.wordpress.org for the latest WordPress version on every
 * call, which makes each command slower and fails it when that request fails. The path only
 * depends on where the config file is, so it is kept after the first call, while the file exists.
 *
 * @returns {Promise<string>} The path.
 */
const getDockerComposeConfigPath = async () => {
	const configDirectoryPath = path.resolve(__dirname, '..');
	const cacheFile = path.join(
		configDirectoryPath,
		'node_modules',
		'.cache',
		'wp-env-cli',
		'docker-compose-path',
	);

	try {
		const cached = fs.readFileSync(cacheFile, 'utf8').trim();

		if (cached && fs.existsSync(cached)) {
			return cached;
		}
	} catch {
		// Not cached yet.
	}

	const { dockerComposeConfigPath } = await loadConfig(configDirectoryPath);

	try {
		fs.mkdirSync(path.dirname(cacheFile), { recursive: true });
		fs.writeFileSync(cacheFile, dockerComposeConfigPath);
	} catch {
		// Not cached: the next call loads the config again.
	}

	return dockerComposeConfigPath;
};

const run = async () => {
	const dockerComposeConfigPath = await getDockerComposeConfigPath();

	const container = process.argv[2];
	const command = process.argv.splice(3).join(' ');

	try {
		const result = await spawnCommandDirectly({
			container,
			command,
			dockerComposeConfigPath,
		});
		console.log(result);
	} catch (error) {
		console.log(error.output);
		process.exit(error.code);
	}
};

run();
