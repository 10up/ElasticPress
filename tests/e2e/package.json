{
	"name": "elasticpress-playwright-utils",
	"version": "0.1.2",
	"description": "Shared Playwright testing utilities for ElasticPress projects.",
	"license": "GPL-2.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/10up/ElasticPress.git",
		"directory": "tests/e2e"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rimraf dist",
		"prepare": "npm run build",
		"prepublishOnly": "npm run clean && npm run build && npm test --if-present"
	},
	"peerDependencies": {
		"@playwright/test": "^1.57.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@types/node": "^26.6.4",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
