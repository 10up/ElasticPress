# Local configuration for the Makefile targets. Copy this file to .env and fill
# in the values you have. .env is gitignored and never committed.
#
# Values are read by make, so avoid `#` and `$` in them.

# ElasticPress.io credentials, required by the setup-e2e-tests-epio* targets.
# These are named after the repository secrets used by the e2e workflow.
EPIO_HOST=
EPIO_CREDENTIALS=
EPIO_INDEX_PREFIX=

# ACF Pro license, optional. Without it every target still runs, but the tests
# that depend on ACF Pro (tagged @paidPlugins) are skipped.
ACF_PRO_LICENSE_KEY=

# Elasticsearch version used by start-e2e. CI covers 7.10.1, 8.12.2 and 9.1.5.
ES_VERSION=8.16.1

# Database used by setup-unit-tests. WP_TESTS_DB_HOST also accepts a socket,
# for example localhost:/path/to/mysqld.sock
WP_TESTS_DB_NAME=ep_wp_test
WP_TESTS_DB_USER=root
WP_TESTS_DB_PASS=root
WP_TESTS_DB_HOST=localhost
